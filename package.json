{
  "name": "smarter-docs-site-generators",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Developer tooling of Smarter Chat for documentation sites: commitlint, semantic-release, Prettier and ESLint. The packages are in docusaurus/, mkdocs/ and sphinx/.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarter-sh/smarter-docs-site-generators.git"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --max-warnings=0 . && prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-angular": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9"
  }
}
